<template>
  <button :interestfor="interestFor" :popovertarget="id" v-bind="$attrs">
    <slot name="anchor" />
  </button>
  <div :id popover="hint"><slot name="content" /></div>
</template>

<script lang="ts" setup>
import { computed, ComputedRef, useId } from "vue";
import ICmPopoverProps from "./interfaces/ICmPopoverProps";

const props = withDefaults(defineProps<ICmPopoverProps>(), {
  toggleMode: "click",
});

const id = useId();

const interestFor: ComputedRef<string | undefined> = computed(() => {
  if (props.toggleMode === "hover") {
    return id;
  }
  return undefined;
});

const anchorName = computed(() => {
  return `--${id}`;
});

defineOptions({
  inheritAttrs: false,
});
</script>

<style lang="scss" scoped>
button {
  anchor-name: v-bind(anchorName);
  interest-delay: 0s 0.25s;
}

[popover] {
  position: absolute;
  justify-self: anchor-center;
  width: fit-content;
  max-width: 20rem;
  padding: var(--spacing-2) var(--spacing-3);
  margin: var(--spacing-4) var(--spacing-4) var(--spacing-2);
  position-area: top;
  position-anchor: v-bind(anchorName);
  position-try-fallbacks: --bottom;
  background: var(--color-white);
  border: 1px solid var(--color-grey);
  border-radius: 0.25rem;
  box-shadow: 0 1px 2px 0 rgb(0 0 0 / 5%);
  opacity: 0;
  translate: 0 -1em;
  transition:
    opacity var(--transition),
    translate var(--transition),
    overlay var(--transition) allow-discrete,
    display var(--transition) allow-discrete;

  &:popover-open {
    opacity: 1;
    translate: 0 0;

    @starting-style {
      opacity: 0;
      translate: 0 -1em;
    }
  }
}

@position-try --bottom {
  margin-block: var(--spacing-2) var(--spacing-4);
  position-area: bottom;
}
</style>
